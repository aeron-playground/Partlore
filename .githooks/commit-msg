#!/bin/sh
# Checks every commit message. Turn on once per clone: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
"$root/scripts/check-commit-msg.sh" file "$1"

# Optional personal checks in .git/hooks/commit-msg.local (never committed).
local_hook="$(git rev-parse --git-common-dir)/hooks/commit-msg.local"
if [ -x "$local_hook" ]; then
    "$local_hook" "$1"
fi
