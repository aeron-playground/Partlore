<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Nothing is backed up yet: the app has no user data, and the content
    pack can always be restored from the APK. Open this up for the user database when it exists.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
