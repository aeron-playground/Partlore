{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Categories",
  "description": "The category tree of the Library tab.",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "categories": {
      "description": "Every category.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "description": "Id parts use.", "$ref": "common.schema.json#/$defs/slug" },
          "name": { "description": "Name shown in the app.", "type": "string", "minLength": 1 },
          "parent": { "description": "Id of the parent category.", "$ref": "common.schema.json#/$defs/slug" },
          "sort": { "description": "Order among siblings, smallest first.", "type": "integer" }
        }
      }
    }
  }
}
