{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gotchas",
  "description": "Traps the datasheet doesn't make obvious.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "gotchas"],
  "properties": {
    "status": { "description": "Check status of this file.", "$ref": "status.schema.json" },
    "gotchas": {
      "description": "One entry per trap.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "body", "cites"],
        "properties": {
          "id": { "description": "Id, unique in this part.", "$ref": "common.schema.json#/$defs/slug" },
          "severity": { "description": "info, caution or danger.", "enum": ["info", "caution", "danger"] },
          "title": { "description": "One line, at most 80 characters.", "type": "string", "minLength": 1, "maxLength": 80 },
          "body": { "description": "What to do about it, in our own words.", "type": "string", "minLength": 1 },
          "pins": {
            "description": "Ids of the pins it is about.",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/slug" }
          },
          "cites": { "description": "Where it is written down.", "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/cite" } }
        }
      }
    }
  }
}
